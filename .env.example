RADP_EMULATOR_API_ROOT=/api/ra
RADP_EMULATOR_LATENCY_MS=2
RADP_EMULATOR_FAILURE_RATE=0.0
RADP_EMULATOR_FAILURE_STATUS=503

# One folder by default. Multiple folders distribute generated certificates round-robin.
RADP_EMULATOR_CERTIFICATE_FOLDERS=default

# Persistent SQLite database (Docker: mounted /app/data volume)
# RADP_EMULATOR_DATABASE_PATH=./data/emulator.sqlite3
